<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1020"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#151830"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:titleTextColor="#EEF0FF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/fieldPhotoPreview"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="#2A2E56"
                android:scaleType="centerCrop"
                android:contentDescription="Фото" />

            <Button
                android:id="@+id/btnPickPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:backgroundTint="#232748"
                android:text="Выбрать фото"
                android:textColor="#EEF0FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Имя"
                android:textColor="#8F94B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/fieldName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1C1F3A"
                android:hint="Например, Мама"
                android:inputType="textPersonName"
                android:padding="14dp"
                android:textColor="#EEF0FF"
                android:textColorHint="#5F6488" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Дата рождения"
                android:textColor="#8F94B8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/fieldDateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:backgroundTint="#1C1F3A"
                android:gravity="start|center_vertical"
                android:text="Выбрать дату"
                android:textAllCaps="false"
                android:textColor="#EEF0FF" />

            <CheckBox
                android:id="@+id/fieldNoYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Не знаю год рождения"
                android:textColor="#EEF0FF"
                android:buttonTint="#7C5CFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Кто это"
                android:textColor="#8F94B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/fieldRelation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1C1F3A"
                android:hint="мама / друг / коллега"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="#EEF0FF"
                android:textColorHint="#5F6488" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Заметка"
                android:textColor="#8F94B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/fieldNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1C1F3A"
                android:gravity="top"
                android:hint="Идеи подарков, телефон…"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="#EEF0FF"
                android:textColorHint="#5F6488" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Напомнить за N дней"
                android:textColor="#8F94B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/fieldRemind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1C1F3A"
                android:inputType="number"
                android:padding="14dp"
                android:text="1"
                android:textColor="#EEF0FF" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#7C5CFF"
                android:text="Сохранить"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#3A1F2A"
                android:text="Удалить"
                android:textColor="#FF8B8B"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
